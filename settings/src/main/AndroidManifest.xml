<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:icon="@mipmap/ic_settings"
            android:label="@string/settings_app_label"
            android:theme="@style/Theme.MesOS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.mesos.intent.action.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- First-start setup, opened by MesOS Home and from Settings → System. -->
        <activity
            android:name=".SetupActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/setup_label"
            android:launchMode="singleTask"
            android:taskAffinity="org.mesos.setup"
            android:theme="@style/Theme.MesOS.Dark" />
    </application>

</manifest>
